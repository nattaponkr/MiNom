# MiNom web — environment
#
# Leave these BLANK to run in DEMO MODE (no backend): the app uses a local
# localStorage + BroadcastChannel store so you can click the full UX and see
# two browser tabs sync. Great for design review; not real multi-device.
#
# Fill them in to run against a real Supabase project (real auth + Postgres +
# Realtime + offline). Get both values from:
#   Supabase dashboard → Project Settings → API
#
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Pre-beta (Phase 3.5). All optional; features degrade gracefully without them. ---

# Analytics (PostHog). No key → analytics is a no-op. EU host for PDPA comfort.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Public base URL used in invite links (e.g. https://minom-production.up.railway.app).
# Falls back to the request origin if unset.
NEXT_PUBLIC_APP_URL=

# Caregiver-invite email sender (Resend) — SERVER-ONLY secrets, never NEXT_PUBLIC.
# No key → invites still work via the copyable link shown in-app (email just isn't sent).
RESEND_API_KEY=
RESEND_FROM=ละมุน <onboarding@resend.dev>

# Supabase SERVICE-ROLE key — SERVER-ONLY, never NEXT_PUBLIC. Used only by
# /api/invite/confirm to auto-confirm an invited user's email (so they skip the
# second confirmation email). Without it, invited signups fall back to the normal
# email-confirmation flow. Get it from Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

